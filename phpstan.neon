includes:
    - vendor/larastan/larastan/extension.neon

parameters:

    paths:
        - app/
        - config/
        - database/

    # Level 9 is the highest level
    level: 8

    ignoreErrors:
        # - '#PHPDoc tag @var [^ ]+ [^ ]+ is not subtype of [^ ]+ [^ ]+#'
        # Se usa desde componentes Volt (.blade.php), que PHPStan no analiza.
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/AuthorizesConsultationEdits.php

    excludePaths:
        # - ./*/*/FileToBeExcluded.php

