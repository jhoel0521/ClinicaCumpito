APP_NAME="VitalTrack Pediátrico"
APP_ENV=production
APP_KEY=             # php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://tu-dominio.coolify.app

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/La_Paz

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# --- Base de datos PostgreSQL ---
# Coolify crea el servicio PostgreSQL y expone estas variables automáticamente
DB_CONNECTION=
DB_HOST=           # hostname del servicio PostgreSQL en Coolify
DB_PORT=5432
DB_DATABASE=vitaltrack
DB_USERNAME=
DB_PASSWORD=

# --- Sesiones, Caché, Colas ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail (configura con tu proveedor real) ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Vite (ya compilado en build, no necesario en producción) ---
VITE_APP_NAME="${APP_NAME}"
